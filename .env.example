# ============================================================
# AlphaPolyBot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file with real credentials!
# ============================================================

# ==================== REQUIRED ====================

# Ollama LLM (local inference — no API key needed)
# Install Ollama: https://ollama.com/download
# Build model: ollama create polytrader -f Modelfile.polytrader
# Default base URL: http://localhost:11434 (configurable in Settings)

## Wallet credentials (server-side only)
# DO NOT expose these in client bundles or use VITE_ prefix!
# These env vars must only be used server-side (or via secure wallet integrations like MetaMask/WalletConnect).
# Never commit real credentials to source control.
#
# Example seed phrase (12/24 words):
# WALLET_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
# Example private key (0x + 64 hex chars):
# WALLET_PRIVATE_KEY=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
#
# Can also be entered in the Settings UI or via secure wallet integrations instead of here.
# WALLET_SEED_PHRASE=
# WALLET_PRIVATE_KEY=

# ==================== EXTERNAL API ENDPOINTS (have defaults) ====================

# Override these only if using proxies, self-hosted alternatives, or different regions
VITE_BINANCE_API_URL=https://api.binance.com/api/v3
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
# Note: All Binance endpoints use global api.binance.com (not .us which is unreliable)
VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ==================== POLYBACKTEST (historical BTC Up/Down data) ====================

# PolyBacktest API key for historical market snapshots and backtesting
# Get from: https://polybacktest.com (sign up, then Dashboard → API Keys)
# Can also be set in the Settings UI instead of here.
# VITE_POLYBACKTEST_API_KEY=pdm_your-key-here

# ==================== MOON DEV (Hyperliquid data layer for cascade prediction) ====================

# Moon Dev API key for Hyperliquid position/liquidation data
# Get from: https://moondev.com (free key)
# Can also be set in the Settings UI instead of here.
# VITE_MOONDEV_API_KEY=your-moondev-key-here

# ==================== POLYMARKET RELAYER (gasless merges, redeems, splits) ====================

# Relayer API key for gasless on-chain transactions (merges, redeems, splits, converts).
# Get from: Polymarket developer portal → Relayer API keys
# Can also be set in Settings → API Keys instead of here (not persisted across reloads).
# VITE_RELAYER_API_KEY=your-relayer-key-here

# ==================== POLYGON RPC (for Chainlink feeds + on-chain merges) ====================

# Polygon mainnet RPC — used by ChainlinkFeedService and MergeService
# Public endpoints work fine, but Alchemy/Infura gives lower latency for sniping
# VITE_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# VITE_POLYGON_RPC_FALLBACK=https://polygon.llamarpc.com

# ==================== SUPABASE (LLM training data backend) ====================

# Supabase project for persisting LLM interactions (training data pipeline)
# Get from: https://supabase.com/dashboard → Project Settings → API
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ==================== DEVELOPMENT ====================

VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=true

# ============================================================
# SETUP CHECKLIST:
# 1. Copy this file: cp .env.example .env
# 2. Install Ollama and build polytrader model (see above)
# 3. Run: npm install && npm run dev
# 4. In app: Settings → Wallet → enter 12/24-word seed phrase
# 5. Click "Connect" to derive wallet and verify balances
# 6. Start in DRY RUN mode, verify trades in Activity
# 7. When confident, disable dry run for live trading
# ============================================================
