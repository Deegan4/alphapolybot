# ============================================================
# AlphaPolyBot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file with real credentials!
# ============================================================

# ==================== REQUIRED ====================

# OpenRouter API Key (for LLM predictions)
# Get from: https://openrouter.ai/keys (create free account)
# Cost: ~$0.003 per market analysis with Claude 3.5 Sonnet
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Wallet credential — seed phrase (12/24 words) or private key (0x + 64 hex chars)
# Used to derive Ethereum wallet → Polymarket CLOB credentials
# IMPORTANT: Use a DEDICATED trading wallet, NOT your main wallet!
# Seed phrase example: VITE_WALLET_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
# Private key example: VITE_WALLET_SEED_PHRASE=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
# Can also be entered in the Settings UI instead of here.
# VITE_WALLET_SEED_PHRASE=

# ==================== EXTERNAL API ENDPOINTS (have defaults) ====================

# Override these only if using proxies, self-hosted alternatives, or different regions
VITE_BINANCE_API_URL=https://api.binance.com/api/v3
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
# Note: All Binance endpoints use global api.binance.com (not .us which is unreliable)
VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==================== POLYBACKTEST (historical BTC Up/Down data) ====================

# PolyBacktest API key for historical market snapshots and backtesting
# Get from: https://polybacktest.com (sign up, then Dashboard → API Keys)
# Can also be set in the Settings UI instead of here.
# VITE_POLYBACKTEST_API_KEY=pdm_your-key-here

# ==================== POLYGON RPC (for Chainlink feeds + on-chain merges) ====================

# Polygon mainnet RPC — used by ChainlinkFeedService and MergeService
# Public endpoints work fine, but Alchemy/Infura gives lower latency for sniping
# VITE_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# VITE_POLYGON_RPC_FALLBACK=https://polygon.llamarpc.com

# ==================== DEVELOPMENT ====================

VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=true

# ============================================================
# SETUP CHECKLIST:
# 1. Copy this file: cp .env.example .env
# 2. Add OpenRouter API key from https://openrouter.ai/keys
# 3. Run: npm install && npm run dev
# 4. In app: Settings → Wallet → enter 12/24-word seed phrase
# 5. Click "Connect" to derive wallet and verify balances
# 6. Start in DRY RUN mode, verify trades in Activity
# 7. When confident, disable dry run for live trading
# ============================================================
