# ============================================================
# AlphaPolyBot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file with real credentials!
# ============================================================

# ==================== REQUIRED ====================

# Wallet Seed Phrase (12 words)
# Get from: Create new wallet in MetaMask or use existing
# WARNING: Use a DEDICATED trading wallet, not your main wallet!
VITE_WALLET_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# OpenRouter API Key (for LLM predictions)
# Get from: https://openrouter.ai/keys (create free account)
# Cost: ~$0.003 per market analysis with Claude 3.5 Sonnet
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ==================== OPTIONAL (have defaults) ====================

# Polygon Network
VITE_POLYMARKET_CHAIN_ID=137
VITE_POLYGON_RPC_URL=https://polygon-rpc.com
VITE_POLYGON_RPC_FALLBACK=https://rpc-mainnet.matic.network

# Polymarket Contracts (Polygon Mainnet - DO NOT CHANGE unless on a different chain)
VITE_POLYMARKET_EXCHANGE_ADDRESS=0x4bFB41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
VITE_POLYMARKET_CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
VITE_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
VITE_USDC_NATIVE_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
VITE_NEG_RISK_CTF_EXCHANGE=0xC5d563A36AE78145C45a50134d48A1215220f80a
VITE_NEG_RISK_EXCHANGE=0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296

# Polymarket API Endpoints
# In development, use proxy paths (/api/gamma, /api/clob) to avoid CORS.
# The Vite dev server proxies these to the real endpoints (see vite.config.ts).
VITE_GAMMA_API_URL=/api/gamma
VITE_CLOB_API_URL=/api/clob
VITE_DATA_API_URL=https://data-api.polymarket.com
VITE_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
VITE_RTDS_WS_URL=wss://ws-live-data.polymarket.com

# ==================== EXTERNAL API ENDPOINTS (have defaults) ====================

# Override these only if using proxies, self-hosted alternatives, or different regions
VITE_GAS_STATION_URL=https://gasstation.polygon.technology/v2
VITE_BINANCE_API_URL=https://api.binance.com/api/v3
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==================== ADVANCED ====================

# Signature type for order signing (only set if you know what you're doing):
#   0 = EOA (no proxy — your seed phrase wallet IS the maker)
#   1 = POLY_PROXY (standard Polymarket proxy wallet, created via email/Magic login)
#   2 = POLY_GNOSIS_SAFE (rare — Gnosis Safe)
# Default: auto-detect (1 if proxy address set, 0 if no proxy)
# VITE_SIGNATURE_TYPE=1

# ==================== COINBASE (for Mean Reversion crypto strategy) ====================

# Coinbase Advanced Trade API credentials
# Get from: https://www.coinbase.com/settings/api
# IMPORTANT: Enable "Trade" permission only. Do NOT enable "Transfer".
# These can also be set in the Settings UI instead of here.
# VITE_COINBASE_API_KEY=your-api-key-here
# VITE_COINBASE_SECRET=your-secret-here

# ==================== DEVELOPMENT ====================

VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=true

# ============================================================
# SETUP CHECKLIST:
# 1. Copy this file: cp .env.example .env
# 2. Add your seed phrase (use dedicated trading wallet!)
# 3. Add OpenRouter API key from https://openrouter.ai/keys
# 4. Fund wallet with USDC + MATIC on Polygon network
# 5. Run: npm install && npm run dev
# 6. In app: Settings → Wallet → Approve Tokens
# 7. Start in DRY RUN mode, verify trades in Activity
# 8. When confident, disable dry run for live trading
# ============================================================
